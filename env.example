# 复制为 ~/.config/hermes-kb/env（tools/nightly.sh 会自动 source），只填你自己的值，不要提交到 git。
# 模型：单一 OpenAI 兼容端点（例如 Gemini 中转）
export KB_MODEL=""
export OPENAI_BASE_URL=""
export OPENAI_API_KEY=""

# 跨机同步（可选）：远端用户名与候选主机（空格分隔）
export MAC_USER=""
export MAC_HOSTS=""

# 语雀同步（tools/sync_yuque.sh）
export KB_YUQUE_TOOL=""
# yuque-exporter 用（YUQUE_REPOS 空格分隔，留空 = 该用户全部知识库）
export YUQUE_TOKEN=""
export YUQUE_USER=""
export YUQUE_REPOS=""
# elog 用：放 elog 配置（elog init 生成）的目录
export KB_YUQUE_ELOG_DIR=""
